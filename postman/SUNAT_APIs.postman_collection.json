{
  "info": {
    "name": "SUNAT APIs — VIGÍA / salud-empresarial",
    "description": "SIRE (RVIE/RCE), Perfil de Cumplimiento y API local Django.\n\nUso:\n1. Llena las variables `client_secret`, `sol_user` y `sol_pass` (pestaña Variables de la colección). NO commitees este archivo con secretos.\n2. Ejecuta `1. Auth > Get SIRE token` — guarda `access_token` automáticamente (username = RUC+usuario CONCATENADO, confirmado contra producción).\n3. El resto de requests SIRE usan ese token vía Bearer.\n4. Para la carpeta 'Perfil de Cumplimiento' pega en `perfil_token` un JWT capturado del portal SOL (expira en 1 hora).\n\nSolo endpoints de LECTURA. No hay sandbox de SUNAT: todo es producción.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "ruc", "value": "20604442533" },
    { "key": "client_id", "value": "d2532985-ca5d-4023-9308-896042c9479f" },
    { "key": "client_secret", "value": "" },
    { "key": "sol_user", "value": "" },
    { "key": "sol_pass", "value": "" },
    { "key": "sire_base", "value": "https://api-sire.sunat.gob.pe/v1/contribuyente/migeigv/libros" },
    { "key": "periodo", "value": "202606" },
    { "key": "trimestre", "value": "202602" },
    { "key": "access_token", "value": "" },
    { "key": "num_ticket", "value": "" },
    { "key": "nom_archivo", "value": "" },
    { "key": "cod_tipo_archivo", "value": "" },
    { "key": "cod_proceso", "value": "" },
    { "key": "perfil_token", "value": "" },
    { "key": "local_base", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Get SIRE token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', data.access_token);",
                  "    console.log('access_token guardado, expira en', data.expires_in, 's');",
                  "} else {",
                  "    console.warn('Token FAIL', pm.response.code, pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "scope", "value": "https://api-sire.sunat.gob.pe" },
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}" },
                { "key": "username", "value": "{{ruc}}{{sol_user}}", "description": "RUC+usuario CONCATENADO (con espacio SUNAT devuelve access_denied)" },
                { "key": "password", "value": "{{sol_pass}}" }
              ]
            },
            "url": {
              "raw": "https://api-seguridad.sunat.gob.pe/v1/clientessol/{{client_id}}/oauth2/token/",
              "protocol": "https",
              "host": ["api-seguridad", "sunat", "gob", "pe"],
              "path": ["v1", "clientessol", "{{client_id}}", "oauth2", "token", ""]
            }
          }
        }
      ]
    },
    {
      "name": "2. SIRE RVIE (ventas, libro 140000)",
      "item": [
        {
          "name": "Periodos RVIE (§5.2)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rvierce/padron/web/omisos/140000/periodos",
              "host": ["{{sire_base}}"],
              "path": ["rvierce", "padron", "web", "omisos", "140000", "periodos"]
            }
          }
        },
        {
          "name": "Descargar propuesta → ticket (§5.18)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.numTicket) {",
                  "        pm.collectionVariables.set('num_ticket', data.numTicket);",
                  "        console.log('num_ticket =', data.numTicket);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rvie/propuesta/web/propuesta/{{periodo}}/exportapropuesta?codTipoArchivo=0",
              "host": ["{{sire_base}}"],
              "path": ["rvie", "propuesta", "web", "propuesta", "{{periodo}}", "exportapropuesta"],
              "query": [{ "key": "codTipoArchivo", "value": "0" }]
            }
          }
        },
        {
          "name": "Estado de ticket (§5.16)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const regs = (pm.response.json().registros || []);",
                  "    const reg = regs.find(r => String(r.numTicket) === pm.collectionVariables.get('num_ticket')) || regs[0];",
                  "    if (reg) {",
                  "        console.log('estado:', reg.codEstadoProceso, reg.desEstadoProceso);",
                  "        pm.collectionVariables.set('cod_proceso', String(reg.codProceso || ''));",
                  "        const file = (reg.archivoReporte || [])[0];",
                  "        if (file) {",
                  "            pm.collectionVariables.set('nom_archivo', file.nomArchivoReporte || '');",
                  "            pm.collectionVariables.set('cod_tipo_archivo', String(file.codTipoAchivoReporte ?? file.codTipoArchivoReporte ?? ''));",
                  "            console.log('archivo:', file.nomArchivoReporte);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rvierce/gestionprocesosmasivos/web/masivo/consultaestadotickets?perIni={{periodo}}&perFin={{periodo}}&page=1&perPage=20&numTicket={{num_ticket}}&codLibro=140000&codOrigenEnvio=2",
              "host": ["{{sire_base}}"],
              "path": ["rvierce", "gestionprocesosmasivos", "web", "masivo", "consultaestadotickets"],
              "query": [
                { "key": "perIni", "value": "{{periodo}}" },
                { "key": "perFin", "value": "{{periodo}}" },
                { "key": "page", "value": "1" },
                { "key": "perPage", "value": "20" },
                { "key": "numTicket", "value": "{{num_ticket}}" },
                { "key": "codLibro", "value": "140000" },
                { "key": "codOrigenEnvio", "value": "2" }
              ]
            },
            "description": "Estados (Anexo III): 01 Cargado, 02 Validando, 03 Procesado con Errores, 04 Procesado sin errores, 05 En proceso, 06 Terminado. Descargable con 03/04/06."
          }
        },
        {
          "name": "Descargar archivo del ticket (§5.17)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rvierce/gestionprocesosmasivos/web/masivo/archivoreporte?nomArchivoReporte={{nom_archivo}}&codTipoArchivoReporte={{cod_tipo_archivo}}&codLibro=140000&perTributario={{periodo}}&codProceso={{cod_proceso}}&numTicket={{num_ticket}}",
              "host": ["{{sire_base}}"],
              "path": ["rvierce", "gestionprocesosmasivos", "web", "masivo", "archivoreporte"],
              "query": [
                { "key": "nomArchivoReporte", "value": "{{nom_archivo}}" },
                { "key": "codTipoArchivoReporte", "value": "{{cod_tipo_archivo}}" },
                { "key": "codLibro", "value": "140000" },
                { "key": "perTributario", "value": "{{periodo}}" },
                { "key": "codProceso", "value": "{{cod_proceso}}" },
                { "key": "numTicket", "value": "{{num_ticket}}" }
              ]
            },
            "description": "Respuesta binaria (ZIP, posiblemente particionado). Usa 'Send and Download' en Postman."
          }
        },
        {
          "name": "Reporte de casillas (§5.23)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rvierce/casillas/e/casillaspropuestas/{{periodo}}/reporte/2/0",
              "host": ["{{sire_base}}"],
              "path": ["rvierce", "casillas", "e", "casillaspropuestas", "{{periodo}}", "reporte", "2", "0"]
            },
            "description": "tipoReporte: 1 Preliminar, 2 Comparada. tipoDescarga: 0 txt, 1 xls, 2 pdf (la evidencia del manual usa el literal 'txt'; si 0 falla, prueba 'txt')."
          }
        },
        {
          "name": "Inconsistencias por CP → ticket (§5.25)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.numTicket) { pm.collectionVariables.set('num_ticket', data.numTicket); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rvie/inconsistencias/web/periodoinconsistencias/{{periodo}}/exporta?codTipoArchivo=0",
              "host": ["{{sire_base}}"],
              "path": ["rvie", "inconsistencias", "web", "periodoinconsistencias", "{{periodo}}", "exporta"],
              "query": [{ "key": "codTipoArchivo", "value": "0" }]
            }
          }
        },
        {
          "name": "Reporte estadístico clientes (§5.33)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rvierce/estadistica/web/resumenestadistico/exportarvie?numRuc={{ruc}}&perTributario={{periodo}}&codTipoArchivo=0&codTipoReporte=1&codLibro=140000",
              "host": ["{{sire_base}}"],
              "path": ["rvierce", "estadistica", "web", "resumenestadistico", "exportarvie"],
              "query": [
                { "key": "numRuc", "value": "{{ruc}}" },
                { "key": "perTributario", "value": "{{periodo}}" },
                { "key": "codTipoArchivo", "value": "0" },
                { "key": "codTipoReporte", "value": "1" },
                { "key": "codLibro", "value": "140000" }
              ]
            }
          }
        },
        {
          "name": "Reporte de cumplimiento (§5.34, PDF base64)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rvierce/cumplimiento/web/omisos/{{periodo}}/140000/consultaReporteCumplimiento/exportardocumento",
              "host": ["{{sire_base}}"],
              "path": ["rvierce", "cumplimiento", "web", "omisos", "{{periodo}}", "140000", "consultaReporteCumplimiento", "exportardocumento"]
            },
            "description": "Respuesta directa (sin ticket): {archivoPdf: base64, nombreArchivoPdf}."
          }
        }
      ]
    },
    {
      "name": "3. SIRE RCE (compras, libro 080000)",
      "item": [
        {
          "name": "Periodos RCE (§5.33)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rvierce/padron/web/omisos/080000/periodos",
              "host": ["{{sire_base}}"],
              "path": ["rvierce", "padron", "web", "omisos", "080000", "periodos"]
            }
          }
        },
        {
          "name": "Descargar propuesta → ticket (§5.34)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.numTicket) { pm.collectionVariables.set('num_ticket', data.numTicket); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rce/propuesta/web/propuesta/{{periodo}}/exportacioncomprobantepropuesta?codTipoArchivo=0&codOrigenEnvio=2",
              "host": ["{{sire_base}}"],
              "path": ["rce", "propuesta", "web", "propuesta", "{{periodo}}", "exportacioncomprobantepropuesta"],
              "query": [
                { "key": "codTipoArchivo", "value": "0" },
                { "key": "codOrigenEnvio", "value": "2" }
              ]
            },
            "description": "El estado del ticket se consulta con el mismo request de la carpeta RVIE cambiando codLibro=080000."
          }
        },
        {
          "name": "Inconsistencias por CP → ticket (§5.44)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rce/inconsistencias/web/periodoinconsistencias/{{periodo}}/080000/exportarinconsistenciasporcomprobantes?codTipoArchivo=0&codOrigenEnvio=2",
              "host": ["{{sire_base}}"],
              "path": ["rce", "inconsistencias", "web", "periodoinconsistencias", "{{periodo}}", "080000", "exportarinconsistenciasporcomprobantes"],
              "query": [
                { "key": "codTipoArchivo", "value": "0" },
                { "key": "codOrigenEnvio", "value": "2" }
              ]
            }
          }
        },
        {
          "name": "Reporte de cumplimiento (§5.58, PDF base64)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{sire_base}}/rvierce/cumplimiento/web/omisos/{{periodo}}/080000/consultaReporteCumplimiento/exportardocumento",
              "host": ["{{sire_base}}"],
              "path": ["rvierce", "cumplimiento", "web", "omisos", "{{periodo}}", "080000", "consultaReporteCumplimiento", "exportardocumento"]
            }
          }
        },
        {
          "name": "Consultar FV0621 (§5.14 — PUT documentado)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{sire_base}}/rce/propuesta/web?periodoSeleccionado={{periodo}}&tipoInfo=FV0621",
              "host": ["{{sire_base}}"],
              "path": ["rce", "propuesta", "web"],
              "query": [
                { "key": "periodoSeleccionado", "value": "{{periodo}}" },
                { "key": "tipoInfo", "value": "FV0621" }
              ]
            },
            "description": "El manual v22 lo documenta como PUT aunque es una consulta (prorrata, RCF, CFE). Sin body."
          }
        }
      ]
    },
    {
      "name": "4. Perfil de Cumplimiento (api.sunat.gob.pe)",
      "description": "Requiere un token del portal SOL (no el de SIRE): pégalo en la variable `perfil_token`. Expira en 1 hora. Se captura del DevTools al abrir Empresas > Perfil de Cumplimiento > Calificación Vigente, o con el scraper compliance_profile.",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{perfil_token}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Cabecera (calificación vigente)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json, text/plain, */*" },
              { "key": "Origin", "value": "https://ww1.sunat.gob.pe" },
              { "key": "Referer", "value": "https://ww1.sunat.gob.pe/" }
            ],
            "url": {
              "raw": "https://api.sunat.gob.pe/v1/contribuyente/perfilcumplimiento/cabecera/{{ruc}}",
              "protocol": "https",
              "host": ["api", "sunat", "gob", "pe"],
              "path": ["v1", "contribuyente", "perfilcumplimiento", "cabecera", "{{ruc}}"]
            }
          }
        },
        {
          "name": "Histórico",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json, text/plain, */*" },
              { "key": "Origin", "value": "https://ww1.sunat.gob.pe" },
              { "key": "Referer", "value": "https://ww1.sunat.gob.pe/" }
            ],
            "url": {
              "raw": "https://api.sunat.gob.pe/v1/contribuyente/perfilcumplimiento/historico/{{ruc}}",
              "protocol": "https",
              "host": ["api", "sunat", "gob", "pe"],
              "path": ["v1", "contribuyente", "perfilcumplimiento", "historico", "{{ruc}}"]
            }
          }
        },
        {
          "name": "Detalle por trimestre",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json, text/plain, */*" },
              { "key": "Origin", "value": "https://ww1.sunat.gob.pe" },
              { "key": "Referer", "value": "https://ww1.sunat.gob.pe/" }
            ],
            "url": {
              "raw": "https://api.sunat.gob.pe/v1/contribuyente/perfilcumplimiento/detalle/{{trimestre}}/{{ruc}}",
              "protocol": "https",
              "host": ["api", "sunat", "gob", "pe"],
              "path": ["v1", "contribuyente", "perfilcumplimiento", "detalle", "{{trimestre}}", "{{ruc}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. API local (Django)",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Perfil de cumplimiento vigente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{local_base}}/api/compliance/ratings/current/",
              "host": ["{{local_base}}"],
              "path": ["api", "compliance", "ratings", "current", ""]
            }
          }
        },
        {
          "name": "Histórico de calificaciones",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{local_base}}/api/compliance/ratings/?rating=&period_from=&severity=",
              "host": ["{{local_base}}"],
              "path": ["api", "compliance", "ratings", ""],
              "query": [
                { "key": "rating", "value": "", "description": "A–E" },
                { "key": "period_from", "value": "", "description": "p.ej. 202501" },
                { "key": "severity", "value": "", "description": "Leve / Grave / Muy grave" }
              ]
            }
          }
        },
        {
          "name": "Buzón SOL — mensajes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{local_base}}/api/messages/",
              "host": ["{{local_base}}"],
              "path": ["api", "messages", ""]
            }
          }
        },
        {
          "name": "Buzón SOL — resumen",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{local_base}}/api/messages/summary/",
              "host": ["{{local_base}}"],
              "path": ["api", "messages", "summary", ""]
            }
          }
        }
      ]
    }
  ]
}
