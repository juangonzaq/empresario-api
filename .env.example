# No hay credenciales SUNAT aquí: cada empresa guarda las suyas cifradas
# (accounts.SunatCredential) desde la pantalla de conexión.

# PostgreSQL
DB_NAME=salud_empresarial
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Lima
LOG_LEVEL=INFO

# API
API_PAGE_SIZE=25

# Correo (SMTP). Sin DJANGO_EMAIL_BACKEND los correos salen por consola,
# que es lo que conviene en desarrollo. Para enviar de verdad:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EMPRESARIO <no-reply@empresario.pe>

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
# Set to True to run tasks inline, without a broker (handy for one-off scripts)
CELERY_TASK_ALWAYS_EAGER=False

# Llave Fernet para cifrar la clave SOL. Genera la tuya con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3001

# Caché compartida (obligatoria en producción: los límites de peticiones y el
# caché del panel se cuentan entre todos los workers).
CACHE_URL=redis://localhost:6379/1

# Límites de peticiones. Bajarlos endurece; subirlos abre la puerta a fuerza bruta.
THROTTLE_LOGIN_ACCOUNT=10/hour
THROTTLE_LOGIN_IP=30/hour
THROTTLE_REGISTER=10/hour
THROTTLE_EMAIL=5/hour

# Sincronización: cuántas empresas a la vez. Debe coincidir con la -c del worker
# de la cola "scraping". Cada una abre un navegador (200-400 MB).
SYNC_CONCURRENCY=4
SYNC_MINUTES_PER_ORG=5

# Clave de firma de los JWT, separada de SECRET_KEY para poder rotar una sin la otra.
JWT_SIGNING_KEY=

# Suscripciones y pagos (billing/)
# Días de prueba gratuita al crear una empresa.
BILLING_TRIAL_DAYS=7
# Pasarela. Con MERCADOPAGO_ACCESS_TOKEN es Mercado Pago sin tocar esto; sin token y sin
# valor aquí NO hay pasarela y el checkout se rechaza. Solo para pruebas locales, a mano:
# fake (aprueba al instante, exige DEBUG) · manual (pendiente + correo, se aprueba en el admin).
BILLING_GATEWAY=
BILLING_NOTIFY_EMAIL=
# Mercado Pago (Suscripciones): Access Token APP_USR-… de un VENDEDOR DE PRUEBA para probar, o de la
# cuenta real para cobrar. Las credenciales TEST-… no sirven para suscripciones (ver docs/mercadopago.md).
# Ver docs/mercadopago.md. Las URLs de retorno y del webhook se deducen del origen desde el que se
# paga (el túnel o tu dominio); API_PUBLIC_URL solo hace falta si el API vive en otro dominio.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Solo con vendedor de prueba: correo del comprador de prueba que pagará (test_user_…@testuser.com).
MERCADOPAGO_TEST_PAYER_EMAIL=
API_PUBLIC_URL=
# Referidos: cada REFERRAL_TARGET referidos que pagan regalan REFERRAL_REWARD_DAYS días.
REFERRAL_TARGET=5
REFERRAL_REWARD_DAYS=30
# Avisos de interesados de la landing (leads/)
LEADS_NOTIFY_EMAIL=
